<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Australia SVG Extractor</title>
    <style>
        body { font-family: sans-serif; padding: 20px; background: #f4f4f9; }
        textarea { width: 100%; height: 60vh; font-family: monospace; padding: 10px; margin-top: 20px; }
        input[type="file"] { padding: 10px; background: #fff; border: 1px solid #ccc; }
    </style>
</head>
<body>

    <h2>Australia SVG Map Formatter</h2>
    <p>Select your downloaded <b>australia.svg</b> file. It will match territories and output your HTML.</p>
    
    <input type="file" id="fileInput" accept=".svg">
    
    <textarea id="outputBox" placeholder="Your formatted <path> tags will appear here..."></textarea>

    <script>
        // Official Australian states and territories
        const states = {
            "ACT": "Australian Capital Territory", 
            "NSW": "New South Wales", 
            "NT": "Northern Territory", 
            "QLD": "Queensland",
            "SA": "South Australia", 
            "TAS": "Tasmania", 
            "VIC": "Victoria", 
            "WA": "Western Australia"
        };

        document.getElementById('fileInput').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const text = e.target.result;
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, "image/svg+xml");
                const paths = doc.querySelectorAll('path');
                
                let formattedHtml = "";
                let count = 0;

                paths.forEach(p => {
                    const id = p.getAttribute('id') || '';
                    const name = p.getAttribute('name') || p.getAttribute('data-name') || p.getAttribute('title') || '';
                    const className = p.getAttribute('class') || '';
                    const d = p.getAttribute('d');
                    
                    if (d && d.length > 10) {
                        let matchedAbbr = null;
                        let matchedName = null;
                        
                        const combinedData = (id + " " + name + " " + className).toLowerCase();

                        // 1. Try matching the full name securely
                        for (const [code, stateName] of Object.entries(states)) {
                            if (combinedData.includes(stateName.toLowerCase())) {
                                matchedAbbr = code;
                                matchedName = stateName;
                                break;
                            }
                        }

                        // 2. Try exact ID matching if name failed
                        if (!matchedAbbr) {
                            const upperId = id.toUpperCase();
                            if (states[upperId]) {
                                matchedAbbr = upperId;
                                matchedName = states[upperId];
                            } else if (upperId.startsWith("AU-") && states[upperId.replace("AU-", "")]) {
                                matchedAbbr = upperId.replace("AU-", "");
                                matchedName = states[matchedAbbr];
                            }
                        }

                        if (matchedAbbr) {
                            formattedHtml += `<path id="AU-${matchedAbbr}" data-region="${matchedName}" d="${d}"/>\n`;
                            count++;
                        }
                    }
                });

                if (count === 0) {
                    document.getElementById('outputBox').value = "Error: Couldn't match paths. Ensure the SVG contains valid Australian regions.";
                } else {
                    document.getElementById('outputBox').value = formattedHtml;
                    alert("Success! " + count + " territories formatted.");
                }
            };
            
            reader.readAsText(file);
        });
    </script>

</body>
</html>
